# Astrbot-CodexCLI Bridge Configuration Example
# Copy this file to `bridge.env` and fill in your values.

# -----------------------------------------------------------------------------
# Core Server Configuration
# -----------------------------------------------------------------------------
# Listen host and port for OpenAI-compatible HTTP bridge
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=18098

# Primary bearer authentication token for AstrBot (min 32 characters)
# AstrBot will use this as its API key when connecting.
BRIDGE_TOKEN=change-this-to-a-secure-random-32-char-token-12345

# Executable path to codex CLI inside the container or host
CODEX_BIN=/codex/node_modules/.bin/codex

# Directory where Codex authentication tokens and state reside
CODEX_HOME=/auth

# -----------------------------------------------------------------------------
# Web Search Extension (Optional)
# -----------------------------------------------------------------------------
# Enable bounded web search endpoint (/v1/ext/search)
BRIDGE_WEB_SEARCH_ENABLED=false

# Dedicated token for search endpoint (min 32 chars, MUST NOT equal BRIDGE_TOKEN)
BRIDGE_WEB_SEARCH_TOKEN=change-this-to-a-search-token-distinct-from-bridge-token

# Rate limit: max search requests per hour (in-process rolling window)
BRIDGE_WEB_SEARCH_RATE_PER_HOUR=20

# -----------------------------------------------------------------------------
# Image Generation Extension (Optional)
# -----------------------------------------------------------------------------
# Enable image generation endpoint (/v1/ext/image)
BRIDGE_IMAGE_ENABLED=false

# Dedicated token for image generation (min 32 chars, MUST NOT equal other tokens)
BRIDGE_IMAGE_TOKEN=change-this-to-an-image-token-distinct-from-other-tokens

# Path to SQLite database enforcing atomic daily budget caps
# BRIDGE_IMAGE_BUDGET_DB=/auth/image_budget.db

# -----------------------------------------------------------------------------
# Outbound Proxy Configuration (Optional)
# -----------------------------------------------------------------------------
# If outbound OpenAI API requests require a proxy
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890
